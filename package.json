{
  "name": "futures-radar-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "dev": "tsx src/main.ts",
    "start": "node --import tsx/esm dist/src/main.js",
    "futures:smoke": "node --import tsx/esm scripts/futures-radar-smoke.ts",
    "db:migrate": "node --import tsx/esm src/storage/db.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "fastify": "^5.11.2",
    "mysql2": "^3.14.0",
    "tsx": "^4.19.2",
    "undici": "^7.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
