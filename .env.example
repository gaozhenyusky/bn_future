HTTP_HOST=127.0.0.1
HTTP_PORT=8787
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=gao
MYSQL_DATABASE=crypto_monitor
MYSQL_CONNECTION_LIMIT=10
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com
# Optional. If empty, the backend uses HTTPS_PROXY and then HTTP_PROXY from the process environment.
BINANCE_HTTP_PROXY=
BITGET_API_BASE_URL=https://api.bitget.com
BITGET_HTTP_TIMEOUT_MS=5000
BITGET_REFERENCE_CACHE_MS=300000
BITGET_REFERENCE_CONCURRENCY=3
BITGET_REFERENCE_DIRECTION_RETURN=0.001
BITGET_REFERENCE_OI_DELTA=0.02
BITGET_REFERENCE_PRICE_GAP=0.003
BITGET_REFERENCE_CONFIDENCE_CAP=0.10
BINANCE_WEB3_SKILLS_DIR=
ONCHAIN_REFRESH_MS=15000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FUTURES_POLL_CONCURRENCY=5
# Limits initial historical REST backfill; live WebSocket subscriptions still cover the full universe.
FUTURES_STARTUP_BACKFILL_SYMBOL_LIMIT=24
FUTURES_REST_POLL_INTERVAL_MS=30000
FUTURES_REST_POLL_SYMBOL_LIMIT=24
FUTURES_VOLUME_RATIO_5M=2
FUTURES_OI_DELTA_5M=0.05
FUTURES_VOLUME_RATIO_15M=1.5
FUTURES_OI_DELTA_15M=0.08
# Retention: hot candles/OI/metrics/reference data 30 days, signals 180 days, raw source events 14 days.
FUTURES_HOT_RETENTION_DAYS=30
FUTURES_SIGNAL_RETENTION_DAYS=180
FUTURES_SOURCE_EVENT_RETENTION_DAYS=14
FUTURES_CLEANUP_INTERVAL_MS=21600000
FUTURES_CLEANUP_BATCH_SIZE=5000
# Positive 5m candle return required for the breakout score factor.
FUTURES_PRICE_RETURN_5M_THRESHOLD=0.03
# Safe execution mode: SIMULATION by default. Demo/Testnet requires a dedicated adapter and credentials.
# BINANCE_PRODUCTION enables real-funds trading (sub-account + small balance strongly recommended).
BINANCE_EXECUTION_MODE=SIMULATION
# Required only when explicitly selecting BINANCE_DEMO_TESTNET; keep unset in simulation mode.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_DEMO_FUTURES_REST_BASE_URL=
# Required only when explicitly selecting BINANCE_PRODUCTION (real funds). Execution endpoint is
# hard-coded to https://fapi.binance.com by runtime validation; keep unset otherwise.
BINANCE_PRODUCTION_API_KEY=
BINANCE_PRODUCTION_API_SECRET=
# Entry requires available margin >= margin of this order x multiplier (default 1.2).
BINANCE_PRODUCTION_MIN_FREE_MARGIN_MULTIPLIER=1.2
EXECUTION_MAX_SLIPPAGE_BPS=15
# OI 积累趋势阈值（长窗口累计 OI 变化率，0.3 = 30%）：资金提前数小时布局的信号
FUTURES_OI_ACCUMULATION_THRESHOLD=0.3
